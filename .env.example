# Copy to .env and change every value marked CHANGE ME (or run `make env`).
# Never commit .env.

# --- Database ---
POSTGRES_USER=inventory
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=inventory
# The application connects as this separate, non-superuser role (created automatically on a
# new database; for an existing one run `make db-least-privilege`). Must differ from above.
APP_DB_USER=inventory_app
APP_DB_PASSWORD=CHANGE_ME_app_db_password

# --- Application ---
ENVIRONMENT=production
LOG_LEVEL=INFO
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_value
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# The address people type in the browser. Used to build password reset links.
FRONTEND_URL=http://localhost:8080
WEB_PORT=8080
# Cookies are automatically Secure on HTTPS requests; true forces Secure everywhere.
COOKIE_SECURE=false
# Interactive API docs (/api/docs) are off in production; set true to publish them.
# EXPOSE_API_DOCS=false

# --- Security tuning ---
LOGIN_MAX_FAILURES=5
LOCKOUT_MINUTES=15
PASSWORD_RESET_MINUTES=30

# --- Store details printed on receipts ---
STORE_NAME=Smart Supermarket
STORE_ADDRESS=Nairobi, Kenya
STORE_PHONE=
STORE_KRA_PIN=
RECEIPT_FOOTER=Thank you for shopping with us!

# --- M-Pesa payment prompt (STK push), optional ---
# Lets the till send an M-Pesa PIN prompt to the customer's phone. Get these from the
# Safaricom Daraja portal (developer.safaricom.co.ke). Leave blank to turn it off.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till / Buy Goods)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Buy Goods only: the till number customers pay to
MPESA_TILL_NUMBER=
# Optional, for instant results: the shop's public HTTPS address and a long random token.
# Without them the app asks Safaricom for each result every few seconds instead.
MPESA_CALLBACK_BASE_URL=
MPESA_CALLBACK_TOKEN=

# --- Document archive, optional ---
# Start it with `make archive`. Staff open it at PAPERLESS_PUBLIC_URL and sign in with the
# admin account below. Approved supplier invoices are filed there automatically once
# PAPERLESS_TOKEN is set (create it with `make archive-token`).
ARCHIVE_PORT=8090
PAPERLESS_PUBLIC_URL=http://localhost:8090
PAPERLESS_SECRET_KEY=CHANGE_ME_paperless_secret
PAPERLESS_ADMIN_USER=archive-admin
PAPERLESS_ADMIN_PASSWORD=CHANGE_ME_paperless_admin_password
# How the Smart Inventory server reaches the archive inside Docker, and its API token:
PAPERLESS_URL=http://archive:8000
PAPERLESS_TOKEN=

# --- AI accounting assistant and AI invoice reading (Claude), optional ---
# An API key from https://console.anthropic.com turns on the "AI assistant" page (questions
# about sales, profit, stock and expenses; reading receipt and invoice photos; recording
# expenses after you confirm) and AI reading of scanned supplier invoices. The key is used
# only by the server. Leave empty to keep both features off (Tesseract OCR is used instead).
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=medium
AI_INVOICE_READING=true

# --- Customer returns and privacy ---
# Printed on every receipt and shown in the terms of use, e.g. "Within 7 days with the receipt."
RETURN_POLICY=
# Who handles personal data questions and requests (shown in the privacy notice).
# Empty = the store phone number.
PRIVACY_CONTACT=

# --- Business rules ---
MAX_CASHIER_DISCOUNT_PERCENT=10
PRICE_CHANGE_ALERT_PERCENT=10
STOCK_ADJUSTMENT_APPROVAL_THRESHOLD=5000
