# Copy to .env and change every value marked CHANGE ME (or run `make env`).
# Never commit .env.

# --- Database ---
POSTGRES_USER=inventory
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=inventory

# --- Application ---
ENVIRONMENT=production
LOG_LEVEL=INFO
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_value
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# The address people type in the browser. Used to build password reset links.
FRONTEND_URL=http://localhost:8080
WEB_PORT=8080
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# --- Security tuning ---
LOGIN_MAX_FAILURES=5
LOCKOUT_MINUTES=15
PASSWORD_RESET_MINUTES=30

# --- Store details printed on receipts ---
STORE_NAME=Smart Supermarket
STORE_ADDRESS=Nairobi, Kenya
STORE_PHONE=
STORE_KRA_PIN=
RECEIPT_FOOTER=Thank you for shopping with us!

# --- Business rules ---
MAX_CASHIER_DISCOUNT_PERCENT=10
PRICE_CHANGE_ALERT_PERCENT=10
STOCK_ADJUSTMENT_APPROVAL_THRESHOLD=5000
